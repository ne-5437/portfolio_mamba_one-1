# Copy to .env.local for local dev, and add the same in
# Vercel → Project → Settings → Environment Variables.
# Both Supabase values: Supabase → Project Settings → API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Used for metadataBase, sitemap.xml, and robots.txt. Set to the real
# production domain once deployed (e.g. https://eshwar.dev).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
